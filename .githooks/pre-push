#!/bin/bash
# 本地 pre-push 钩子：推送前跑**静态检查**（SwiftLint --strict + 两个守卫脚本），
# 把「本地全绿、CI 挂静态检查」这类返工挡在推送之前。
#
# ── 为什么默认不启用 ──────────────────────────────────────────────────────────
# git **不会**自动启用仓库里的钩子（`core.hooksPath` 缺省指 `.git/hooks`），所以这里不接进任何
# 构建流程 —— 想用的人自己开一次（文档在 CONTRIBUTING.md「提交前必须跑」）：
#     git config core.hooksPath .githooks
#
# ⚠️ 三条边界（改这个文件前先读）：
#   ① 它**不是门禁**：只覆盖静态检查，且**本地可跳过**（`SKIP_VERIFY=1 git push`）。
#      真正的门禁是 CI 里那条分支保护的必需检查，谁也绕不过。
#   ② 钩子只在**本机**生效：别人的克隆、CI 上的 checkout 都不会跑它 ⇒
#      **别把任何「必须发生」的事只放在这里**。
#   ③ 故意**不跑 `swift build` / `swift test`** —— 那要几分钟，push 前等它是折磨，
#      结果就是大家一律 `--no-verify`，把纪律一起丢掉。编译与测试交给 CI。
#   ④ 依赖没装时**响亮警告后放行**（见下）：**不静默 skip**（要说出「这次没验」），
#      但也不把一个没装 swiftlint 的推送挡死。
set -uo pipefail
cd "$(dirname "$0")/.." || exit 0

if [ "${SKIP_VERIFY:-}" = "1" ]; then
  echo "⚠ pre-push：SKIP_VERIFY=1 —— 本次跳过静态检查（CI 上仍会跑，别当已经验过）"
  exit 0
fi

fail=0

# ── SwiftLint（与 CI 同一条命令：--strict，warning 也算失败）──
if command -v swiftlint >/dev/null 2>&1; then
  echo "pre-push：swiftlint lint --strict …"
  if ! swiftlint lint --strict --config .swiftlint.yml Sources; then
    echo "✖ pre-push：SwiftLint 未通过"
    fail=1
  fi
else
  echo "⚠ pre-push：没找到 swiftlint ⇒ **这一项没有验**（与 CI 同版本：0.65.0 portable）"
  echo "           安装：https://github.com/realm/SwiftLint/releases/download/0.65.0/portable_swiftlint.zip"
fi

# ── 机械守卫（纯文本检查，很快）──
for guard in scripts/check_service_layer_deps.py scripts/check_dead_tokens.py \
             scripts/check_ios_shared_sources.py; do
  [ -f "$guard" ] || continue
  echo "pre-push：$guard …"
  if ! python3 "$guard" --quiet; then
    echo "✖ pre-push：$guard 未通过"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "✖ pre-push：静态检查没过，已拦下这次推送。"
  echo "  · 确实要跳过：SKIP_VERIFY=1 git push"
  echo "  · ⚠ 就算跳过，CI 仍会跑这些检查 —— 跳过只是把返工推迟到推送之后。"
  exit 1
fi

echo "pre-push：静态检查全绿。⚠ 不含 swift build / swift test，那两项以 CI 为准。"
exit 0
