coverage.lcov
*.profdata

# Mobile (iOS) build artifacts
Mobile/.derivedData
Mobile/.derivedData-*

# Xcode user state
xcuserdata/
*.xcuserstate

# wrangler 本地缓存
.wrangler/
.dev.vars
Vendor/
