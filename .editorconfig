root = true

# 跨编辑器的统一约定：这里兜住 SwiftLint / Xcode 都不管的那些（换行符、文件末尾空行、
# 行尾空格、缩进宽度）。SwiftLint 管的是 Swift 的语义与风格。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown 行尾两空格是「硬换行」，不能删
[*.md]
trim_trailing_whitespace = false

# ⚠️ .pbxproj 是**制表符**缩进，而且本仓的 iOS 工程是手工维护的（Shared 组逐条枚举）。
# 编辑器若按空格重排，会产出整文件级 diff，把真正的改动埋掉。
[*.pbxproj]
indent_style = tab
indent_size = 1
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.js]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
